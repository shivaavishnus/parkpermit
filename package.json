{
  "name": "parkpermit",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm test -w server && npm test -w client",
    "uat": "npm run uat -w server",
    "gen:data": "node data/generator/generate.js",
    "check:data": "node scripts/check-data-manifest.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  }
}
